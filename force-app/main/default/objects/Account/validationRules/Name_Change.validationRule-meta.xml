<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Name_Change</fullName>
    <active>false</active>
    <errorConditionFormula>IF(ISCHANGED(Name)&amp;&amp;(ISPICKVAL(Type,&quot;Customer - DIRECT&quot;)||
ISPICKVAL(Type,&quot;Customer - CHANNEL&quot;)),True ,false)</errorConditionFormula>
    <errorMessage>You can&apos;t change the Account name for &quot;Customer -Direct&quot; or &quot;Customer Channel&quot;</errorMessage>
</ValidationRule>
